{
  "name": "shamsalasrar",
  "version": "0.1.0",
  "private": true,
  "description": "Shams al-Asrar - local RKP horary app powered by a deterministic judgment engine.",
  "scripts": {
    "android": "react-native run-android",
    "fonts": "node scripts/download-fonts.mjs",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "bundle:android": "cd android && ./gradlew bundleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest --testPathIgnorePatterns=firestore.rules.test.ts --testPathIgnorePatterns=functions/",
    "test:watch": "jest --watch --testPathIgnorePatterns=firestore.rules.test.ts --testPathIgnorePatterns=functions/",
    "test:web": "npx serve ./hosting",
    "test:coverage": "jest --coverage --testPathIgnorePatterns=firestore.rules.test.ts --testPathIgnorePatterns=functions/",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore \"jest --config jest.rules.config.cjs --runInBand\"",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:single": "maestro test",
    "check:orphans": "npx madge --extensions ts,tsx --ts-config tsconfig.json --orphans src",
    "validate:firebase:predeploy": "powershell -ExecutionPolicy Bypass -File scripts/Validate-FirebasePredeploy.ps1",
    "postinstall": "npx patch-package || echo \"No patches\""
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/functions/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|@react-native-firebase|@react-native-google-signin|@react-navigation|react-native-mmkv|react-native-reanimated|react-native-svg)"
    ],
    "moduleNameMapper": {
      "react-native-mmkv": "<rootDir>/__mocks__/react-native-mmkv.js",
      "swisseph-wasm": "<rootDir>/__mocks__/swisseph-wasm.js"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "dependencies": {
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-firebase/app": "19.3.0",
    "@react-native-firebase/app-check": "19.3.0",
    "@react-native-firebase/auth": "19.3.0",
    "@react-native-firebase/crashlytics": "19.3.0",
    "@react-native-firebase/firestore": "19.3.0",
    "@react-native-firebase/functions": "19.3.0",
    "@react-native-google-signin/google-signin": "16.1.2",
    "@react-navigation/bottom-tabs": "7.18.8",
    "@react-navigation/native": "7.3.8",
    "@react-navigation/native-stack": "7.17.10",
    "react": "19.0.0",
    "react-native": "0.78.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-iap": "12.16.4",
    "react-native-mmkv": "2.12.2",
    "react-native-reanimated": "3.19.5",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.18.0",
    "react-native-svg": "15.15.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.20.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native/babel-preset": "0.78.3",
    "@react-native/eslint-config": "0.78.3",
    "@react-native/metro-config": "0.78.3",
    "@react-native/typescript-config": "0.78.3",
    "@types/jest": "^29.5.12",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "firebase": "^10.14.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "3.3.3",
    "react-test-renderer": "19.0.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
